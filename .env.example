# 이 파일을 복사해 .env.local 로 이름을 바꾸고 값을 채워 주세요.
# .env.local 은 git에 올라가지 않습니다.

# 공공데이터포털 인증키 (마이페이지 > 데이터활용 > Open API)
# 호출이 안 되면 Encoding 키와 Decoding 키를 바꿔 넣어 보세요.
DATA_GO_KR_KEY=

# 아래 두 주소는 각 데이터 상세 페이지의 "요청주소"와 다르면 그 주소로 바꿔 주세요.
KSTARTUP_URL=https://apis.data.go.kr/B552735/kisedKstartupService01/getAnnouncementInformation01
GOV24_URL=https://api.odcloud.kr/api/gov24/v3/serviceList

# Supabase 대시보드 상단 Connect > Connection String > Method: Session pooler
# 비밀번호는 대괄호 없이 넣고, 특수문자는 URL 인코딩하세요 (예: @ → %40).
DATABASE_URL=
